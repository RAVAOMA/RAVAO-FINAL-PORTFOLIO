# Run: python scripts/setup_env.py
# The script replaces this placeholder with a unique local secret.
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# For PythonAnywhere: DEBUG=False, your exact hostname above,
# https://YOUR_USERNAME.pythonanywhere.com for CSRF origins, and True below.
DJANGO_SECURE_SSL_REDIRECT=False
